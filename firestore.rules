rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Un usuario es admin si existe un documento con su uid en `admins`.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Se crea/borra a mano desde la consola de Firebase, no hay UI para
    // gestionarla. El propio usuario puede leer su documento (para saber si
    // es admin); nadie escribe desde el cliente.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // species: de lectura pública. La escritura directa está reservada al
    // admin (edición y alta de especies); el resto de este catálogo de
    // referencia (stratums, ecologicalFunctions, additionalFunctions) sigue
    // siendo de solo lectura, se administra desde la consola/scripts.
    match /species/{speciesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stratums/{stratumId} {
      allow read: if true;
      allow write: if false;
    }

    match /ecologicalFunctions/{functionId} {
      allow read: if true;
      allow write: if false;
    }

    match /additionalFunctions/{functionId} {
      allow read: if true;
      allow write: if false;
    }

    // Experiencias compartidas por la comunidad sobre una especie.
    // Lectura pública para que el conocimiento circule libremente; escritura
    // sólo para usuarios autenticados sobre su propio registro.
    match /experiences/{experienceId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.speciesId is string
        && request.resource.data.speciesId.size() > 0
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 200
        && request.resource.data.climate is string
        && request.resource.data.climate.size() > 0
        && request.resource.data.climate.size() <= 200
        && request.resource.data.lightExposure in ['H', 'M', 'L']
        && request.resource.data.soilType is string
        && request.resource.data.soilType.size() > 0
        && request.resource.data.soilType.size() <= 200
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() <= 5;

      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Sugerencias de la comunidad para editar una especie existente o agregar
    // una nueva. El admin ve y resuelve todas; el autor puede ver el estado
    // de las suyas. Sin delete: el estado final queda como historial mínimo.
    match /speciesSuggestions/{suggestionId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.authorId == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['edit', 'new']
        && (request.resource.data.type == 'new' || (request.resource.data.speciesId is string && request.resource.data.speciesId.size() > 0))
        && request.resource.data.proposedData is map
        && request.resource.data.proposedData.taxonomy is map
        && request.resource.data.proposedData.taxonomy.genus is string
        && request.resource.data.proposedData.taxonomy.genus.size() > 0
        && request.resource.data.proposedData.taxonomy.genus.size() <= 200
        && request.resource.data.proposedData.taxonomy.species is string
        && request.resource.data.proposedData.taxonomy.species.size() > 0
        && request.resource.data.proposedData.taxonomy.species.size() <= 200
        && request.resource.data.proposedData.commonNames is map
        && request.resource.data.proposedData.stratums is list
        && request.resource.data.proposedData.ecologicalZones is map
        && request.resource.data.proposedData.ecologicalFunctions is list
        && request.resource.data.proposedData.additionalFunctions is list
        && request.resource.data.proposedData.height is map
        && request.resource.data.proposedData.crownWidth is map;

      allow update: if isAdmin();
    }
  }
}
